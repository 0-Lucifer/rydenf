# Copy this file to .env and replace with your actual API key
# DO NOT commit .env to version control

# Google Maps / Places / Routes API key
# Get this from: https://console.cloud.google.com/apis/credentials
# Required APIs enabled: Maps SDK Android, Maps SDK iOS, Places API, Routes API
GOOGLE_MAPS_API_KEY=YOUR_API_KEY_HERE

# ─── Teammate Onboarding ─────────────────────────────────
# 1. Copy this file:       cp .env.example .env
# 2. Paste your API key above
# 3. Also add the key to android/local.properties:
#      GOOGLE_MAPS_API_KEY=YOUR_API_KEY_HERE
#    (local.properties is auto-created by Flutter, just append the line)
# 4. Run: flutter pub get && flutter run
